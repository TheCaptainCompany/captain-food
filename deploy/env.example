# Shape of the runtime environment files on the box. NONE of these are committed with real values.
#
#   /etc/captain-food/app.env      -- the application's configuration (mode 600, owner root)
#   /etc/captain-food/db.env       -- DATABASE_URL, written by provision.sh, do not hand-edit
#   /etc/captain-food/backup.env   -- object-storage credentials for the backup scripts
#
# The authoritative catalog of application keys is specs/configuration.yaml -- it declares every
# key, its type, who supplies it per profile, and what breaks when it is wrong. This file only shows
# the FILE LAYOUT; it is not a second source of truth and must not drift into one.
#
# Boot behaviour: the config fail-fast report (ADR-20260729-010500) stops the container on a missing
# required value, so a half-configured box fails visibly at deploy time rather than degrading later.

# =========================================================================================
# /etc/captain-food/db.env  -- written by provision.sh when it creates the role
# =========================================================================================
# DATABASE_URL=postgres://captain_food:<generated>@127.0.0.1:5432/captain_food
#
# 127.0.0.1 because PostgreSQL is on the HOST and the app container uses host networking.
# Copy this exact value into the repo secret DATABASE_URL as well -- db-migrate.yml reaches it
# through an SSH tunnel, so the URL it uses is the same loopback one.

# =========================================================================================
# /etc/captain-food/app.env
# =========================================================================================
# --- Runtime identity ---
PORT=8080
WEB_ASSETS_DIR=/app/web-assets

# --- Cache / projection target (#267) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Identity: Supabase stays, for identity ONLY (ADR-20260731-061609) ---
# Unchanged by this migration. auth_ref remains an opaque subject string.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Telemetry (Honeycomb EU -- a GDPR constraint, not a preference) ---
HONEYCOMB_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.eu1.honeycomb.io

# --- SMS (OVH) -- see specs/configuration.yaml for what each key is and why it is named this way ---
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_SMS_SERVICE_NAME=
OVH_ENDPOINT=https://eu.api.ovh.com/1.0

# =========================================================================================
# /etc/captain-food/backup.env
# =========================================================================================
# Scaleway Object Storage, Paris. A DIFFERENT provider from the compute on purpose: the archive
# must survive losing the OVH account, while staying in France.
#
# rclone is configured entirely through environment variables here, so there is no rclone.conf to
# keep in sync with anything.
#
# RCLONE_CONFIG_BACKUP_TYPE=s3
# RCLONE_CONFIG_BACKUP_PROVIDER=Scaleway
# RCLONE_CONFIG_BACKUP_ENDPOINT=s3.fr-par.scw.cloud
# RCLONE_CONFIG_BACKUP_REGION=fr-par
# RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
# RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_BACKUP_STORAGE_CLASS=ONEZONE_IA
#
# REMOTE=backup:captain-food-backups
# KEEP_REMOTE_DAYS=30
#
# Create the Scaleway API key with write access to ONE bucket. A credential that can delete every
# backup is not a backup credential -- if the box is compromised, the archive is the last thing left.
